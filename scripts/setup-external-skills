#!/usr/bin/env python3
"""Install or update the recommended global external skills."""

from __future__ import annotations

import argparse
import json
import shlex
import subprocess
import sys
from collections.abc import Sequence
from pathlib import Path
from typing import TypedDict


SKILLS_COMMAND = ("npx", "skills@latest")
AWS_TOOLKIT_COMMAND = ("aws", "agent-toolkit")
AWS_REGION = ("--region", "us-east-1")
AWS_SOURCE = "aws agent-toolkit"
MANIFEST = Path(__file__).resolve().parents[1] / "external-skills.json"
TARGET_AGENTS = ("codex", "claude-code")
TARGET_AGENT_DISPLAY_NAMES = frozenset({"Codex", "Claude Code"})


class SetupError(Exception):
    """Raised when setup cannot proceed without overwriting another owner."""


class InstalledSkill(TypedDict):
    source: str | None
    agents: frozenset[str]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            f"Install the skills listed in {MANIFEST.name} that are missing and "
            "update the installed ones globally."
        )
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the changes without installing or updating skills",
    )
    return parser.parse_args()


def run(command: Sequence[str], *, capture: bool = False) -> str:
    if not capture:
        print(f"$ {shlex.join(command)}", flush=True)
    result = subprocess.run(
        command,
        check=False,
        capture_output=capture,
        text=True,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() if capture else "command failed"
        raise SetupError(f"{shlex.join(command)}: {detail}")
    return result.stdout


def list_global_skills() -> dict[str, InstalledSkill]:
    output = run((*SKILLS_COMMAND, "list", "--global", "--json"), capture=True)
    try:
        records = json.loads(output)
    except json.JSONDecodeError as error:
        raise SetupError(f"npx skills returned invalid JSON: {error}") from error

    if not isinstance(records, list):
        raise SetupError("npx skills returned a non-list global inventory")

    installed: dict[str, InstalledSkill] = {}
    for record in records:
        if not isinstance(record, dict):
            raise SetupError("npx skills returned an invalid global skill record")
        name = record.get("name")
        source = record.get("source")
        agents = record.get("agents")
        if not isinstance(name, str):
            raise SetupError("npx skills returned a global skill without a name")
        if source is not None and not isinstance(source, str):
            raise SetupError(f"npx skills returned an invalid source for {name}")
        if not isinstance(agents, list) or not all(
            isinstance(agent, str) for agent in agents
        ):
            raise SetupError(f"npx skills returned invalid agents for {name}")
        installed[name] = {"source": source, "agents": frozenset(agents)}
    return installed


def list_aws_skills() -> frozenset[str]:
    output = run(
        (*AWS_TOOLKIT_COMMAND, "list-installed-skills", "--output", "json", *AWS_REGION),
        capture=True,
    )
    try:
        records = json.loads(output)["skills"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise SetupError(f"aws agent-toolkit returned an invalid inventory: {error}") from error
    if not isinstance(records, list) or not all(
        isinstance(record, dict) and isinstance(record.get("name"), str) for record in records
    ):
        raise SetupError("aws agent-toolkit returned an invalid skill record")
    return frozenset(record["name"] for record in records)


def load_manifest() -> dict[str, tuple[str, ...]]:
    try:
        raw_manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise SetupError(f"Cannot read {MANIFEST}: {error}") from error
    if not isinstance(raw_manifest, dict) or not all(
        isinstance(source, str)
        and isinstance(skills, list)
        and all(isinstance(skill, str) for skill in skills)
        for source, skills in raw_manifest.items()
    ):
        raise SetupError(f"{MANIFEST} must map each install source to a list of skill names")
    return {source: tuple(skills) for source, skills in raw_manifest.items()}


def inventory_source(install_source: str) -> str:
    return install_source.removeprefix("https://")


def expected_sources(manifest: dict[str, tuple[str, ...]]) -> dict[str, str]:
    expected: dict[str, str] = {}
    for install_source, skills in manifest.items():
        source = inventory_source(install_source)
        for skill in skills:
            if skill in expected:
                raise SetupError(
                    f"Recommended skill {skill} is listed for both "
                    f"{expected[skill]} and {source}"
                )
            expected[skill] = source
    return expected


def ensure_no_conflicts(installed: dict[str, InstalledSkill], expected: dict[str, str]) -> None:
    conflicts = [
        f"{name} is owned by "
        f"{installed[name]['source'] or 'an unmanaged local source'}, not {source}"
        for name, source in expected.items()
        if name in installed and installed[name]["source"] != source
    ]
    if conflicts:
        details = "\n".join(f"- {conflict}" for conflict in conflicts)
        raise SetupError(f"Refusing to overwrite existing skills:\n{details}")


def main() -> int:
    args = parse_args()
    try:
        manifest = load_manifest()
        aws_skills = manifest.pop(AWS_SOURCE, ())
        expected = expected_sources(manifest)
        installed = list_global_skills()
        ensure_no_conflicts(installed, expected)

        installed_recommendations = sorted(
            name
            for name, source in expected.items()
            if name in installed and installed[name]["source"] == source
        )
        missing_by_source = {
            source: tuple(
                name
                for name in skills
                if name not in installed
                or not TARGET_AGENT_DISPLAY_NAMES.issubset(installed[name]["agents"])
            )
            for source, skills in manifest.items()
        }

        installed_aws = list_aws_skills() if aws_skills else frozenset()
        for name in aws_skills:
            action = "update-skill" if name in installed_aws else "add-skill"
            command = (*AWS_TOOLKIT_COMMAND, action, "--skill-name", name, *AWS_REGION)
            if args.dry_run:
                print(f"$ {shlex.join(command)}")
            else:
                run(command)

        for source, missing in missing_by_source.items():
            if not missing:
                continue
            command = (
                *SKILLS_COMMAND,
                "add",
                source,
                "--global",
                "--yes",
                *(argument for agent in TARGET_AGENTS for argument in ("--agent", agent)),
                "--skill",
                *missing,
            )
            if args.dry_run:
                print(f"$ {shlex.join(command)}")
            else:
                run(command)

        if installed_recommendations:
            command = (
                *SKILLS_COMMAND,
                "update",
                *installed_recommendations,
                "--global",
                "--yes",
            )
            if args.dry_run:
                print(f"$ {shlex.join(command)}")
            else:
                run(command)

        if args.dry_run:
            print("dry run complete")
            return 0

        final_inventory = list_global_skills()
        ensure_no_conflicts(final_inventory, expected)
        missing = sorted(
            name
            for name in expected
            if name not in final_inventory
            or not TARGET_AGENT_DISPLAY_NAMES.issubset(
                final_inventory[name]["agents"]
            )
        )
        if aws_skills:
            missing += sorted(set(aws_skills) - list_aws_skills())
        if missing:
            raise SetupError(
                "Recommended skills are still missing: " + ", ".join(missing)
            )

        unlisted = sorted(
            f"{name} ({record['source']})"
            for name, record in final_inventory.items()
            if record["source"] is not None and name not in expected
        )
        if unlisted:
            print(f"not in {MANIFEST.name}: " + ", ".join(unlisted))

        print(
            f"setup complete: {len(expected)} npx skills and "
            f"{len(aws_skills)} AWS Agent Toolkit skills present"
        )
        return 0
    except (OSError, SetupError) as error:
        print(f"setup failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
