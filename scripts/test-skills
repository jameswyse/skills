#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "pytest==8.4.2",
# ]
# ///
"""Run repository tooling tests and the imported PR watcher tests."""

from pathlib import Path

import pytest


REPOSITORY = Path(__file__).resolve().parents[1]


if __name__ == "__main__":
    raise SystemExit(
        pytest.main(
            [
                "-q",
                "-p", "no:cacheprovider",
                str(REPOSITORY / "tests"),
                str(REPOSITORY / "skills/engineering/babysit-pr/scripts/test_gh_pr_watch.py"),
            ]
        )
    )
